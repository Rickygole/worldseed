# Copy to .env and fill in. Never commit .env.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
TAVILY_API_KEY=

# Optional server-side overrides (leave empty to use the defaults in frontend/lib/server).
# Model overrides: one ID becomes the primary, or a comma list replaces the whole fallback chain.
WS_MODEL_PLANNER=
WS_MODEL_CRITIC=
WS_MODEL_PARSER=
WS_MODEL_NARRATOR=
WS_MODEL_EXTRACTOR=
# Global daily spend ceiling in USD (default 1) and per-mission token budgets (defaults 60000 in, 12000 out).
WS_DAILY_BUDGET_USD=
WS_MISSION_INPUT_TOKENS=
WS_MISSION_OUTPUT_TOKENS=
# Per-IP limits (defaults 5 missions/hour, 15/day, 10 closure searches/hour) and Tavily caps (30 calls/day, 6 h cache).
WS_IP_MISSIONS_PER_HOUR=
WS_IP_MISSIONS_PER_DAY=
WS_IP_CLOSURES_PER_HOUR=
WS_TAVILY_DAILY_CAP=
WS_TAVILY_CACHE_MS=
# Per-call model timeout and total route deadline in milliseconds (defaults 28000 and 55000).
WS_LLM_TIMEOUT_MS=
WS_ROUTE_DEADLINE_MS=
