# Copy to .env and fill in. Never commit .env.
NEBIUS_API_KEY=
# Must be https on a *.nebius.com host (or a host listed in WS_ALLOWED_BASE_HOSTS); otherwise the provider is disabled.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
TAVILY_API_KEY=

# Kill switch: set to off to make every AI route answer "AI planner unavailable" with no provider call.
WS_LIVE_AI=

# Shared state for the abuse controls (per-IP limits, daily spend ledger, mission records, closure counter and cache).
# Set EITHER the Upstash names OR the Vercel marketplace names. Without them the controls are per-process only
# ("instance-local"), and on a serverless host (VERCEL set) the daily budget drops to WS_INSTANCE_LOCAL_BUDGET_USD.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional server-side overrides (leave empty to use the defaults in frontend/lib/server).
# Model overrides: one ID becomes the primary, or a comma list replaces the whole fallback chain.
WS_MODEL_PLANNER=
WS_MODEL_CRITIC=
WS_MODEL_PARSER=
WS_MODEL_NARRATOR=
WS_MODEL_EXTRACTOR=
# Prices in USD per million tokens (default 1 in / 3 out for every model, deliberately conservative).
# WS_MODEL_PRICES is a comma list of model-id=in/out pairs.
WS_PRICE_IN_PER_M=
WS_PRICE_OUT_PER_M=
WS_MODEL_PRICES=
# Global daily spend ceiling in USD (default 1), its rollover hour in UTC (default 8), and the much lower per-instance
# ceiling used when no shared store is configured on a serverless host (default 0.25).
WS_DAILY_BUDGET_USD=
WS_BUDGET_RESET_HOUR_UTC=
WS_INSTANCE_LOCAL_BUDGET_USD=
# Per-mission token budgets (defaults 60000 in, 12000 out), provider calls per mission (default 12) and per request (max 3).
WS_MISSION_INPUT_TOKENS=
WS_MISSION_OUTPUT_TOKENS=
WS_MISSION_MAX_CALLS=
WS_MAX_ATTEMPTS_PER_REQUEST=
# Per-IP limits (defaults 5 missions/hour, 15/day, 10 closure searches/hour) and Tavily caps (30 calls/day, 6 h cache).
WS_IP_MISSIONS_PER_HOUR=
WS_IP_MISSIONS_PER_DAY=
WS_IP_CLOSURES_PER_HOUR=
WS_TAVILY_DAILY_CAP=
WS_TAVILY_CACHE_MS=
# Per-call model timeout, total route deadline and closure-lookup deadline in milliseconds (defaults 28000, 50000, 45000).
WS_LLM_TIMEOUT_MS=
WS_ROUTE_DEADLINE_MS=
WS_CLOSURES_DEADLINE_MS=
WS_MODELS_CACHE_MS=
# Client identification: how many proxy hops in x-forwarded-for are trusted (default 1, counted from the right),
# origins allowed to call the POST routes besides the site itself (comma list), extra allowed provider hosts (comma list).
WS_TRUSTED_PROXY_HOPS=
WS_ALLOWED_ORIGINS=
WS_ALLOWED_BASE_HOSTS=
# Optional private salt for the hashed client keys kept in the shared store.
WS_IP_HASH_SALT=
